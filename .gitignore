# =============================================================================
# FieldTrack Pro - Repository-Wide Git Ignore
# =============================================================================

# --- Secrets & Environment: never commit -------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets.*
**/local.properties
local.properties

# --- Internal Documentation, Audits & Design Workspace -----------------------
docs/
Sentio Mind application/
*.docx
*.zip
scratch/
.system_generated/

# --- Database dumps / backups ------------------------------------------------
*.dump
*.sql.gz
*.bak
*.backup
*.sqlite
*.sqlite3
*.db
backups/
FieldTrackPro_Backups/

# --- Python / Backend --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
temp_*.py

# --- Node / Frontend ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
.vite/
*.local
.eslintcache

# --- Android / Gradle --------------------------------------------------------
.gradle/
captures/
.externalNativeBuild/
.cxx/
*.iml
*.apk
*.aab
*.aar
app/build/
build/

# --- Logs / Temp Outputs -----------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
pytest_output.txt
pytest_full_output.txt
server_log.txt

# --- Editors / OS ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
.gemini/

# --- Local Media Storage (runtime artifact) ----------------------------------
fieldtrackpro-backend/media_storage/**
!fieldtrackpro-backend/media_storage/.gitkeep
