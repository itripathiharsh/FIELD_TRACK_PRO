# Android Environment Configuration
# BASE_URL must point to the root backend host with a trailing slash (e.g. http://10.0.2.2:8000/ for emulator).
# Do NOT append /api/v1 as API Retrofit interfaces define explicit 'api/v1/...' paths.
BASE_URL=http://10.0.2.2:8000/
