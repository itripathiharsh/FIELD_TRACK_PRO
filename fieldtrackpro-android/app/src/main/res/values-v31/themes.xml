<resources>
    <!-- Android 12+: the system splash IS the app splash (navy + mark). The Compose splash continues it seamlessly. -->
    <style name="Theme.FieldTrackPro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ft_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ft_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
    </style>
</resources>
