<?xml version="1.0" encoding="utf-8"?>
<!--
    P0-3: cleartext HTTP is only ever needed for local development against an
    emulator/host machine (e.g. http://10.0.2.2:8000). This debug-only
    manifest override merges the attribute into debug builds alone - the main
    manifest (used by release) no longer declares it, so a release build
    defaults to HTTPS-only per the platform default for targetSdk >= 28.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
