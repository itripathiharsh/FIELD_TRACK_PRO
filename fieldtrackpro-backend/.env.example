# FieldTrack Pro Backend - Environment Template
#
# Copy to `.env` and replace every placeholder with a real value.
# `.env` is gitignored and MUST NEVER be committed.
# Generate strong secrets, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Application Settings
ENVIRONMENT=dev
API_V1_PREFIX=/api/v1
DEBUG=true

# Database Configuration (PostgreSQL 17 + PostGIS 3.5)
# Use a dedicated least-privilege application role, NOT the postgres superuser.
DATABASE_URL=postgresql+asyncpg://fieldtrack_app:your_db_password@127.0.0.1:5432/fieldtrackpro_dev

# CORS Allowed Origins (JSON list)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# JWT Secret Key (min 32 chars, cryptographically random)
JWT_SECRET=your_jwt_secret_key_here

# JWT Lifetimes
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Storage Provider: LOCAL | MINIO
STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_PATH=media_storage

# MinIO / S3 object storage (only used when STORAGE_PROVIDER=MINIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=fieldtrackpro-dev
MINIO_SECURE=false

# Firebase (optional; leave blank to disable)
FIREBASE_CREDENTIALS_PATH=
