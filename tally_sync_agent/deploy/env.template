# FieldTrack Tally Sync Agent - configuration. Copy to ".env" next to the exe and fill in every placeholder value.
# The .env holds the agent key: never email it, never commit it.
TALLY_URL=http://127.0.0.1:9000
TALLY_TIMEOUT_SECONDS=180

BACKEND_URL=https://51-79-158-138.sslip.io
BACKEND_TIMEOUT_SECONDS=60

AGENT_ID=REPLACE_ME
AGENT_KEY=REPLACE_ME
ORGANIZATION_ID=REPLACE_ME

# Agent 3.0 is READ-ONLY towards Tally: it contains no write-back code (TALLY_WRITEBACK_ENABLED is ignored).

BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# Agent 2.0
# First date synced = start of Tally's current period (ledger opening balances refer to it).
SYNC_FROM_DATE=2026-04-01
# Ledger balances + Bills Receivable snapshot interval.
BALANCE_INTERVAL_MINUTES=60
# Agent 3.0 reconciliation (MANIFEST_INTERVAL_HOURS is no longer used: the manifest is the nightly run's last step).
# Hourly: Tally's voucher headers of today-31 .. today are compared with FieldTrack; missing / changed vouchers are
# fetched, vouchers Tally no longer lists are retired. Nightly (once per IST date from RECONCILE_NIGHTLY_HOUR): the
# whole FY, month by month, then one manifest.
RECONCILE_HOURLY_MINUTES=60
RECONCILE_HOURLY_DAYS=31
RECONCILE_NIGHTLY_HOUR=1
# Pause between one-day requests to Tally during the first load / manifest (keeps Tally responsive).
DAY_REQUEST_PAUSE_SECONDS=0.5
# Voucher GUID manifest: month = one request per calendar month (default, 2.0.1); day = one request per day (2.0.0).
MANIFEST_SCAN_MODE=month
# Agent 2.1.0
# Leave AGENT_INSTANCE_NAME empty for the production agent. Set it (1-20 of A-Z 0-9 _) ONLY for a separate
# instance running beside the production agent (e.g. STAGING); such an instance must point BACKEND_URL at a
# non-production backend and is installed with:  install_agent.ps1 -InstanceName STAGING
AGENT_INSTANCE_NAME=
ALLOW_NAMED_INSTANCE_ON_PRODUCTION=false
# The company is selected BY GUID (2.2.0). Keep this set: the agent refuses a different company, and refuses
# to run when several companies are loaded in TallyPrime.
EXPECTED_COMPANY_GUID=19a03e17-e1ab-44f2-8e7f-1bff56f20ebe

# Agent 2.2.0 - financial years
# Every FY the agent knows. Today's FY must be listed, and SYNC_FROM_DATE must be its first day.
FINANCIAL_YEARS=2024-25,2025-26,2026-27
# Historical FYs whose vouchers the agent UPLOADS. KEEP EMPTY until historical import is explicitly approved.
# Even when set, the agent uploads nothing historical unless the backend reports history_safe (release 2.2.0).
# FY 2024-25 is verified empty in the current company (1 capital receipt, 2 cancelled vouchers): do not list it.
HISTORY_UPLOAD=
HISTORY_DAYS_PER_CYCLE=31
HISTORY_INCREMENTAL_MINUTES=60
HISTORY_MANIFEST_HOURS=168

# --- Agent 2.2.1: protection of TallyPrime (defaults shown; omit these lines to keep the defaults) ---
# After each Tally request the agent waits max(TALLY_MIN_PAUSE_SECONDS, TALLY_DUTY_FACTOR x request time),
# so it uses at most 1/(1+factor) of Tally's time (50% with 1.0). A failed / timed-out request opens a
# cool-down (TALLY_COOLDOWN_SECONDS, doubling up to TALLY_COOLDOWN_MAX_SECONDS) during which nothing is sent.
TALLY_DUTY_FACTOR=1.0
TALLY_MIN_PAUSE_SECONDS=2
TALLY_LOCK_WAIT_SECONDS=300
TALLY_COOLDOWN_SECONDS=180
TALLY_COOLDOWN_MAX_SECONDS=1800
