# Backend FastAPI Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Map configuration for MapLibre GL JS
# By default, the application uses OpenStreetMap raster tiles (no API key required).
# For production, uncomment and set VITE_MAPLIBRE_TILE_URL to your own tile provider.
# VITE_MAPLIBRE_TILE_URL=https://your-tile-provider.com/style.json
