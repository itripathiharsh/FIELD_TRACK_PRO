# Backend FastAPI Base URL (REQUIRED for production builds).
# Production: must be an https:// URL. `vite build` fails, and the app shows a
# configuration error screen, if this is missing. There is no silent fallback.
# Development only: if unset, http://127.0.0.1:8000/api/v1 is used.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Map configuration for MapLibre GL JS
# By default, the application uses OpenStreetMap raster tiles (no API key required).
# For production, uncomment and set VITE_MAPLIBRE_TILE_URL to your own tile provider
# (https only; vercel.json CSP already allows any https: tile/style host).
# VITE_MAPLIBRE_TILE_URL=https://your-tile-provider.com/style.json

# Android APK download on the login page (optional).
# Absolute https URL of the production-signed APK (e.g. a GitHub release asset or
# object storage link). Takes priority over the bundled file. If unset, the page
# uses /downloads/FieldTrackPro.apk from public/downloads/ (git-ignored; place the
# release APK there before deploying, or host it externally if it is large).
# VITE_APK_DOWNLOAD_URL=https://example.com/downloads/FieldTrackPro.apk
