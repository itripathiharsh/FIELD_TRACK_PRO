# FieldTrack Pro backend - PRODUCTION environment for the OVH VPS.
#
# Install as /etc/fieldtrack/backend.env  (owner root, group fieldtrack, mode 640).
# NEVER commit the filled-in file. Every value marked <GENERATE> or <SET> must be replaced before the service starts;
# the app refuses to start in production if the security-critical ones are missing (MEDIA_SIGNING_SECRET, SMS/SMTP policy).
#
# Generate secrets ON THE SERVER, never on a shared machine:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 17 + PostGIS on localhost only) -----------------------------------------------------------
# DB passwords MUST be alphanumeric (generate with:  openssl rand -hex 24 ). Characters such as # @ / ? : % break the URL
# and the helper scripts parse it without percent-decoding.
# Runtime role: least privilege (see scripts/grant_runtime_role.sql). Password: the one given to db/01_roles_and_database.sql.
DATABASE_URL=postgresql+asyncpg://fieldtrack_app:<SET_APP_DB_PASSWORD>@127.0.0.1:5432/fieldtrackpro_prod
# Migration/owner role: used ONLY by alembic and the bootstrap scripts, never by the running API.
MIGRATION_DATABASE_URL=postgresql+asyncpg://fieldtrack_owner:<SET_OWNER_DB_PASSWORD>@127.0.0.1:5432/fieldtrackpro_prod

# --- Secrets (three DIFFERENT random values; rotating one must not invalidate another) -------------------------------
JWT_SECRET=<GENERATE>
MEDIA_SIGNING_SECRET=<GENERATE>
OTP_HMAC_SECRET=<GENERATE>

# --- Web origin(s) allowed to call the API (EXACT origins, no wildcard, no localhost). Comma list or JSON array. --------
# Admin web app stays on Vercel for now:
CORS_ALLOWED_ORIGINS=https://fieldtrack-pro-rosy.vercel.app

# --- Reverse proxy: Caddy is the single hop in front of uvicorn; the app reads X-Forwarded-For itself ----------------
TRUSTED_PROXY_HOPS=1

# --- Auth policy ----------------------------------------------------------------------------------------------------
ENFORCE_PASSWORD_CHANGE=true
TEMP_PASSWORD_EXPIRY_MINUTES=30

# --- Background jobs run INSIDE the API process with no locking: keep exactly ONE uvicorn worker ----------------------
ENABLE_SCHEDULER=true

# --- File storage: persistent local disk on the VPS (NOT ephemeral; backed up by deploy/ovh-vps/scripts/backup.sh) -------
STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_PATH=/var/lib/fieldtrack/media
# To use S3-compatible storage instead: STORAGE_PROVIDER=MINIO and set MINIO_ENDPOINT/ACCESS_KEY/SECRET_KEY/BUCKET/SECURE
# (production refuses default credentials, localhost endpoints and buckets containing "dev").

# --- Email / SMS (password-reset OTP) -------------------------------------------------------------------------------
# INTERIM (no domain / SMTP / SMS provider yet): the app refuses to start in production without SMTP_HOST and a real
# SMS_PROVIDER unless the next line is true. With it on, OTP delivery does NOT work: forgot-password cannot actually
# deliver a code, so staff password recovery goes through an Admin (Reset Password) until real providers are configured.
# REMOVE THIS LINE once SMTP_* and SMS_* below are filled in.
ALLOW_MOCK_COMMUNICATIONS=true
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM_EMAIL=noreply@<your-domain>
#SMS_PROVIDER=msg91
#SMS_API_KEY=
#SMS_SENDER_ID=
#SMS_TEMPLATE_ID=

# --- Push notifications (optional): path to the Firebase service-account JSON, kept OUTSIDE the repo ------------------
#FIREBASE_CREDENTIALS_PATH=/etc/fieldtrack/firebase-service-account.json

# --- Organisation profile shown in the app. The built-in defaults contain a PLACEHOLDER GSTIN: set the real values. ----
#ORGANIZATION_GSTIN=<real GSTIN>
#ORGANIZATION_CONTACT_EMAIL=
#ORGANIZATION_CONTACT_PHONE=
